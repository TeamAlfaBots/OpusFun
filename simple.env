# ==========================================================
#  OpusFun — environment configuration
#  Copy this file to `.env` and fill in your own values.
#  NEVER commit the real .env file.
# ==========================================================

# --- Telegram credentials (required) ----------------------
# Get API_ID / API_HASH from https://my.telegram.org  ->  API development tools
API_ID=
API_HASH=
# Get BOT_TOKEN from @BotFather
BOT_TOKEN=

# --- Database (required) ----------------------------------
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=opusfun

# --- Owners (required) ------------------------------------
# Comma-separated Telegram user IDs. Get yours from @userinfobot
# Example: OWNER_IDS=123456789,987654321
OWNER_IDS=

# --- Branding ---------------------------------------------
BOT_NAME=OpusFun
# Direct image URL, or a path relative to the project root (e.g. assist/start.jpg)
START_IMG_URL=

# --- Inline button links ----------------------------------
SUPPORT_URL=https://t.me/your_support_chat
UPDATE_URL=https://t.me/your_update_channel
OWNER_URL=https://t.me/your_username
DEVELOPER_URL=https://t.me/your_username

# --- Behaviour (optional, sensible defaults shown) --------
COUPLE_COOLDOWN_HOURS=6
BROADCAST_CONCURRENCY=8
BROADCAST_SLEEP=0.15
MEDIA_CACHE_TTL=300
WORKERS=8
DEFAULT_LANGUAGE=en

# --- Logging (optional) -----------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=opusfun.log

